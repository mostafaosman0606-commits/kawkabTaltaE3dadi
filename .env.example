# ==============================================================================
# KAWKAB TALTA E3DADI — CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase PostgreSQL & Auth Credentials
# (If left empty, the application automatically runs in persistent local-storage mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Configuration
VITE_APP_NAME="كوكب تالتة إعدادي"
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SECURE SERVER-SIDE SECRETS (NEVER EXPOSE IN CLIENT BUNDLES WITH VITE_ PREFIX!)
# These secrets must be stored ONLY in Supabase Secrets or Server Environment:
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# GEMINI_API_KEY=your-server-side-gemini-key-here
# OPENAI_API_KEY=your-server-side-openai-key-here
